NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Public Supabase project URL and anon key. Required by user-scoped clients.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Never expose to browser or mobile clients.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only fallback for JWT verification. Leave empty to use JWKS.
SUPABASE_JWT_SECRET=
