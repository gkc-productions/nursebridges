# Shared local development defaults.
# Do not put production secrets in this file.

# Supabase public project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API server-only settings.
PORT=3000
CORS_ORIGIN=*
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only JWT verification secret.
# Leave empty to use Supabase JWKS verification.
SUPABASE_JWT_SECRET=
