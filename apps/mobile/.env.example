EXPO_PUBLIC_ENV_TUNNEL_LABEL=Tunnel
EXPO_PUBLIC_ENV_LOCAL_BASE=http://localhost:3000
EXPO_PUBLIC_ENV_TUNNEL_BASE=https://api.nursebridges.com
