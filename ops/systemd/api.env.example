# Copy to /etc/nursebridge/api.env on the production host.
# Real file must be root:root and chmod 600.
# Do not commit real values.

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://admin.nursebridges.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Leave empty/unset to use Supabase JWKS verification.
SUPABASE_JWT_SECRET=
